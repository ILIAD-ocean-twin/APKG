  "dct:title": "openoil_pipeline",
  "dct:description": "This pipeline runs an oil spill simulation with openoil, creates an animation of the simulation and stores it in S3.\n\nThe animation step is optional:\n    - If the input animation is set to false, the animation step is skipped.\n    - The default value is true (run the animation step).\n\nThe step of saving the results to S3 is optional:\n    - if the input endpoint is not set, the S3 step is skipped.\n",
  "geo:hasGeometry": {
    "@type": "apkg-rec:Geometry",
    "apkg-rec:geometryType": "Polygon",
    "apkg-rec:coordinates": "[[[-180.0,-90.0],[180.0,-90.0],[180.0,90.0],[-180.0,90.0],[-180.0,-90.0]]]"
  },
  "dcat:keyword": [
    "oil spill",
    "openoil",
    "opendrift",
    "animation"
  ],
