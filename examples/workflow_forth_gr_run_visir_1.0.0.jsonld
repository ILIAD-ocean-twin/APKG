  "dct:title": "Execution of VISIR model",
  "dct:description": "Solving Dijkstra's optimization algorithm to find optimal ship routes that minimize CO2 emissions, trip time and distance. Using VISIR II software (https://zenodo.org/records/10960842 created by CMCC), that runs using forcing from either CMRL's (https://crl.iacm.forth.gr/en/) high resolution models in the southern Greece region forecasting atmospheric state (WRF 3km x 3km), hydrodynamics (NEMO 1km x 1km) and waves (Wavewatch III 1km x 1km), or the GFS/CMEMS lower resolution forecasts to be able to generalize to routes globally.",
  "geo:hasGeometry": {
    "@type": "apkg-rec:Geometry",
    "apkg-rec:geometryType": "Polygon",
    "apkg-rec:coordinates": "[[[-180.0,-90.0],[180.0,-90.0],[180.0,90.0],[-180.0,90.0],[-180.0,-90.0]]]"
  },
  "dcat:keyword": [
    "hidromod",
    "visir",
    "VISIR",
    "least CO2 emissions",
    "optimal ship routes",
    "least distance",
    "least time",
    "regional",
    "high resolution",
    "global",
    "FORTH",
    "CMRL"
  ],
