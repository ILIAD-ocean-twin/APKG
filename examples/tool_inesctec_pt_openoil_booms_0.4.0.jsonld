  "apkg-pro:processClass": "CommandLineTool",
  "apkg-pro:hasInput": [
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "latitude",
      "apkg-pro:parameterType": "double",
      "dct:description": "Spill center latitude (WGS-84)"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "longitude",
      "apkg-pro:parameterType": "double",
      "dct:description": "Spill center longitude (WGS-84)"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "radius",
      "apkg-pro:parameterType": "int",
      "dct:description": "Initial radius of the oil spill on the sea surface"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "start_time",
      "apkg-pro:parameterType": "string",
      "dct:description": "Calendar date and time when the spill begins (UTC)"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "duration",
      "apkg-pro:parameterType": "int",
      "dct:description": "Total number of hours to simulate"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "particles",
      "apkg-pro:parameterType": "int?",
      "dct:description": "Number of particles used to represent the oil slick.  More particles provide higher detail, require more computation time"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "mass",
      "apkg-pro:parameterType": "int?",
      "dct:description": "Total mass of oil spilled in kilograms"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "reader_ocean",
      "apkg-pro:parameterType": "string?",
      "dct:description": "THREDDS or OPeNDAP URL for ocean currents data"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "reader_wave",
      "apkg-pro:parameterType": "string?",
      "dct:description": "THREDDS or OPeNDAP URL for wave data"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "reader_wind",
      "apkg-pro:parameterType": "string?",
      "dct:description": "THREDDS or OPeNDAP URL for wind data"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "time_step",
      "apkg-pro:parameterType": "int?",
      "dct:description": "Model's internal calculation interval"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "time_step_output",
      "apkg-pro:parameterType": "int?",
      "dct:description": "Result interval. Must be greater than time_step"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "density",
      "apkg-pro:parameterType": "double?",
      "dct:description": "Mass per unit volume of the oil"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "viscosity",
      "apkg-pro:parameterType": "double?",
      "dct:description": "Oil's resistance to flow"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "oil_type",
      "apkg-pro:parameterType": "string?",
      "dct:description": "Type of oil spilled. This determines its physical and chemical properties"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "booms",
      "apkg-pro:parameterType": "string",
      "dct:description": "List of containment booms"
    }
  ],
  "apkg-pro:hasOutput": [
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "map",
      "apkg-pro:parameterType": "File",
      "dct:description": "Map of particles"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "result",
      "apkg-pro:parameterType": "File",
      "dct:description": "Result NetCDF file"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "simulation",
      "apkg-pro:parameterType": "File",
      "dct:description": "Video of particle simulation"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "simulation_currents",
      "apkg-pro:parameterType": "File?",
      "dct:description": "Video of particle simulation with currents data"
    },
    {
      "@type": "apkg-pro:Parameter",
      "dct:identifier": "statistics",
      "apkg-pro:parameterType": "File",
      "dct:description": "Extra process data"
    }
  ]
}
