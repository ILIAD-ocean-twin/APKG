{
    "@context": {
        "apkg": "http://purl.org/apkg/terms/",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "sh": "http://www.w3.org/ns/shacl",
        "dct": "http://purl.org/dc/terms/",
        "dcat": "http://www.w3.org/ns/dcat#",
        "time": "http://www.w3.org/2006/time#",
        "schema": "https://schema.org/",
        "cwl": "https://w3id.org/cwl/cwl#",
        "cwltool": "http://commonwl.org/cwltool#",
        "gj": "http://purl.org/geojson/vocab#",

        "id": {"@id": "schema:identifier"},
        "geometry": {
            "@id": "apkg:hasGeometry",
            "@context": {
                "type": "dct:type",
                "coordinates": "gj:coordinates"
            }
        },
        
        "name": "schema:name",
        "identifier": {"@id": "dct:identifier", "@type": "xsd:anyURI"},
        "class": "dct:type",
        "description": "schema:description",
        "keywords": "schema:keywords",
        "family": { "@id": "apkg:family", "@type": "xsd:anyURI" },
        "latest": "apkg:latest",
        "date_created": "schema:dateCreated",
        "url": "schema:url",
        "registration_url": "apkg:originalURL",
        "citation": "schema:citation",
        "license": "schema:license",
        "code_repository": "schema:codeRepository",
        "sdPublisher": "schema:sdPublisher",
        "sdDatePublished": "schema:sdDatePublished",
        "programming_language": "schema:programmingLanguage",
        "software_version": "schema:softwareVersion",

        "source_organization": "schema:sourceOrganization",
        "producer": "schema:producer",
        "author": "schema:author",
        "maintainer": "schema:maintainer",
        "contributor": "schema:contributor",
        "publisher": "schema:publisher",

        "spatial_coverage": "schema:spatialCoverage",
        "temporal_coverage": {
            "@id": "apkg:hasTemporalCoverage",
            "@context": {
                "hasBeginning": "time:hasBeginning",
                "hasEnd": "time:hasEnd"
            }
        },

        "inputs": {
            "@id": "apkg:hasInput",
            "@context": {
                "id": "dct:identifier",
                "label": "apkg:label",
                "type": "dct:type",
                "doc": "apkg:doc",
                "format": "schema:fileFormat"
            }
        },
        "outputs": {
            "@id": "apkg:hasOutput",
            "@context": {
                "id": "dct:identifier",
                "type": "dct:type",
                "label": "apkg:label",
                "doc": "apkg:doc",
                "format": "schema:fileFormat"
            }
        },

        "links": {
            "@id": "apkg:hasLink",
            "@context": {
                "title": "dct:title",
                "rel": "dct:type",
                "type": "dcat:mediaType",
                "href": "schema:url"
            }
        },

        "Secrets": {
            "@id": "cwltool:Secrets",
            "@context": {
                "secrets": "cwltool:secrets"
            }
        }
    }
}
